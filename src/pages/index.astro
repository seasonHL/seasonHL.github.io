---
import { Image } from 'astro:assets'
import { featuredProjects } from '@/data/projects'

import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button, Icon, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import avatar from '@/assets/avatar.png'
import config from '@/site-config'

const focusAreas = [
  'AI product prototypes',
  'Developer tools',
  'Desktop interaction',
  'Full-stack systems'
]

const toolchain = [
  'TypeScript',
  'React',
  'Astro',
  'Next.js',
  'Tauri',
  'Nest.js',
  'Prisma',
  'Flutter'
]

const MAX_POSTS = 4
const allPosts = await getBlogCollection()
const latestPosts = sortMDByDate(allPosts).slice(0, MAX_POSTS)
---

<PageLayout
  meta={{
    title: '首页',
    description: 'seasonHL 的个人网站，展示 AI 工具、开发者工具、桌面应用和全栈产品实验。'
  }}
  highlightColor='#D97706'
>
  <main class='flex w-full flex-col items-center'>
    <section
      class='portfolio-hero animate grid w-full gap-8 pb-12 pt-4 md:grid-cols-[1.05fr_0.95fr] md:items-end'
    >
      <div class='flex flex-col gap-y-7'>
        <div class='flex flex-wrap gap-2'>
          <span
            class='rounded-full border border-foreground/10 bg-background/70 px-3 py-1 text-sm text-muted-foreground shadow-sm'
          >
            Creative full-stack builder
          </span>
          <span
            class='rounded-full border border-foreground/10 bg-background/70 px-3 py-1 text-sm text-muted-foreground shadow-sm'
          >
            AI tools / DX / desktop apps
          </span>
        </div>

        <div class='flex flex-col gap-y-5'>
          <h1 class='max-w-3xl text-4xl font-semibold leading-tight sm:text-5xl md:text-6xl'>
            把有意思的想法做成能运行的工具、产品和桌面实验。
          </h1>
          <p class='max-w-2xl text-lg leading-8 text-muted-foreground'>
            我是 {config.author}，关注 AI 工具、开发者体验、可视化和本地自动化。
            我喜欢从一个模糊的问题出发，设计交互、搭起系统，然后把它磨成可以被别人使用的作品。
          </p>
        </div>

        <div class='flex flex-wrap gap-3'>
          <Button title='查看项目' href='/projects' variant='ahead' />
          <Button title='阅读博客' href='/blog' variant='pill' />
          <Button title='GitHub' href='https://github.com/seasonHL' variant='pill' />
        </div>
      </div>

      <aside class='hero-panel relative overflow-hidden rounded-2xl border bg-card p-5 shadow-sm'>
        <div class='relative z-10 flex items-start gap-4'>
          <Image
            src={avatar}
            alt='seasonHL avatar'
            class='size-16 rounded-2xl border bg-background p-1'
            loading='eager'
          />
          <div class='flex flex-col gap-y-2'>
            <h2 class='text-xl font-semibold'>{config.author}</h2>
            <div class='flex flex-wrap gap-x-4 gap-y-2'>
              <Label title='China'>
                <Icon name='location' class='size-5' slot='icon' />
              </Label>
              <Label title='GitHub' as='a' href='https://github.com/seasonHL' target='_blank'>
                <Icon name='github' class='size-5' slot='icon' />
              </Label>
            </div>
          </div>
        </div>

        <div class='relative z-10 mt-8 grid grid-cols-2 gap-3'>
          {
            focusAreas.map((area) => (
              <div class='rounded-xl border bg-background/75 p-3'>
                <p class='text-sm font-medium'>{area}</p>
              </div>
            ))
          }
        </div>
      </aside>
    </section>

    <div id='content' class='animate flex w-full flex-col gap-y-12 md:w-5/6'>
      <section class='flex flex-col gap-y-5'>
        <div class='flex flex-col justify-between gap-3 md:flex-row md:items-end'>
          <div>
            <p class='text-sm uppercase tracking-[0.18em] text-muted-foreground'>Selected work</p>
            <h2 class='mt-2 text-2xl font-semibold'>精选项目</h2>
          </div>
          <Button title='全部项目' class='w-fit' href='/projects' variant='ahead' />
        </div>

        <div class='grid grid-cols-1 gap-4 md:grid-cols-2'>
          {
            featuredProjects.map((project, index) => (
              <article class='project-feature group flex min-h-72 flex-col justify-between overflow-hidden rounded-2xl border bg-card p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:border-foreground/20 hover:shadow-md'>
                <div class='flex flex-col gap-y-5'>
                  <div class='flex items-start justify-between gap-4'>
                    <div>
                      <p class='text-sm text-muted-foreground'>{project.category}</p>
                      <h3 class='mt-1 text-2xl font-semibold'>{project.name}</h3>
                    </div>
                    <span class='project-index text-4xl font-semibold text-muted-foreground/25'>
                      {String(index + 1).padStart(2, '0')}
                    </span>
                  </div>

                  <p class='text-base leading-7 text-muted-foreground'>{project.description}</p>

                  <div class='flex flex-wrap gap-2'>
                    {project.stack.slice(0, 5).map((item) => (
                      <span class='rounded-full bg-muted px-3 py-1 text-sm text-muted-foreground'>
                        {item}
                      </span>
                    ))}
                  </div>
                </div>

                <div class='mt-7 flex flex-wrap gap-3'>
                  {project.links.map((link) => (
                    <a
                      class='rounded-full border bg-background px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:border-foreground/25 hover:text-foreground'
                      href={link.href}
                      target='_blank'
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section
        class='grid gap-6 rounded-2xl border bg-card p-5 md:grid-cols-[0.85fr_1.15fr] md:p-7'
      >
        <div>
          <p class='text-sm uppercase tracking-[0.18em] text-muted-foreground'>Working range</p>
          <h2 class='mt-2 text-2xl font-semibold'>技术能力</h2>
          <p class='mt-4 leading-7 text-muted-foreground'>
            我更偏向“把完整体验做出来”的工程路径：从产品原型、前端交互、后端数据模型，到桌面端和工具链。
          </p>
        </div>
        <div class='flex flex-wrap content-start gap-2'>
          {
            toolchain.map((skill) => (
              <span class='rounded-xl border bg-background px-3 py-2 text-sm'>{skill}</span>
            ))
          }
        </div>
      </section>

      {
        latestPosts.length > 0 && (
          <section class='flex flex-col gap-y-5'>
            <div class='flex flex-col justify-between gap-3 md:flex-row md:items-end'>
              <div>
                <p class='text-sm uppercase tracking-[0.18em] text-muted-foreground'>Notes</p>
                <h2 class='mt-2 text-2xl font-semibold'>最近文章</h2>
              </div>
              <Button title='更多文章' class='w-fit' href='/blog' variant='ahead' />
            </div>
            <ul class='flex flex-col gap-y-2'>
              {latestPosts.map((post) => (
                <PostPreview post={post} />
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </main>
</PageLayout>

<style>
  .portfolio-hero {
    min-height: calc(100dvh - 12rem);
  }

  .hero-panel::before {
    position: absolute;
    inset: -35% -15% auto auto;
    width: 16rem;
    height: 16rem;
    content: '';
    background:
      linear-gradient(135deg, hsl(38 92% 56% / 0.3), transparent 65%),
      linear-gradient(45deg, hsl(188 64% 44% / 0.22), transparent 70%);
    border-radius: 999px;
    filter: blur(2px);
  }

  .project-feature {
    background-image:
      linear-gradient(135deg, hsl(var(--card)) 0%, hsl(var(--card)) 58%, hsl(38 92% 56% / 0.08)),
      radial-gradient(circle at top right, hsl(188 64% 44% / 0.12), transparent 42%);
  }

  .project-feature:nth-child(even) {
    background-image:
      linear-gradient(135deg, hsl(var(--card)) 0%, hsl(var(--card)) 58%, hsl(188 64% 44% / 0.08)),
      radial-gradient(circle at top right, hsl(38 92% 56% / 0.13), transparent 42%);
  }
</style>
