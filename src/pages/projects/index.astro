---
import { Image } from 'astro:assets'

import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'others', text: '其他' }
]
---

<PageLayout title='项目' {headings} view>
  <p>GitHub 活动：</p>
  <p>
    <Image
      src='https://ghchart.rshah.org/659eb9/seasonHL'
      alt='github activities'
      inferSize
      loading='lazy'
    />
  </p>

  <h2 id='others'>其他</h2>
  <ProjectSection
    projects={[
      {
        name: 'depspy',
        description: 'Python 项目依赖分析工具',
        links: [{ type: 'github', href: 'https://github.com/seasonHL/depspy' }]
      },
      {
        name: 'seasonHL',
        description: 'seasonHL 的个人网站。',
        links: [{ type: 'github', href: 'https://github.com/seasonHL/seasonHL.github.io' }]
      }
    ]}
  />
</PageLayout>
