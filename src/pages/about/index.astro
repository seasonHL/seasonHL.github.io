---
import { Button, Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import Substats from '@/components/about/Substats.astro'
import ToolSection from '@/components/about/ToolSection.astro'

const headings = [
  { depth: 2, slug: 'focus', text: '关注方向' },
  { depth: 2, slug: 'tools', text: '常用工具' },
  { depth: 2, slug: 'social-networks', text: '社交网络' },
  { depth: 2, slug: 'about-site', text: '关于这个网站' }
]
---

<PageLayout title='关于' {headings} comment>
  <p>创意型全栈产品工程师，关注 AI 工具、开发者工具和桌面交互实验。</p>
  <p>
    我喜欢把一个想法推进到可以被使用的状态：先弄清楚问题，再设计交互，搭起前后端或桌面端系统，
    最后用真实的 Demo、文档和迭代记录证明它不是只停留在概念里。
  </p>
  <p>
    这个网站会逐步沉淀我的项目、技术笔记和产品复盘。当前最想展示的是 DepSpy、Prompt Hub、 Desktop
    Agent 和 OpenClaw Desktop Pet。
  </p>
  <Button title='查看精选项目' class='w-fit' href='/projects' variant='ahead' />

  <h2 id='focus'>关注方向</h2>
  <ul>
    <li>AI 工具与 Agent 工作流</li>
    <li>开发者体验、CLI 与可视化工具</li>
    <li>Tauri 桌面应用与本地自动化</li>
    <li>从产品原型到全栈实现的完整闭环</li>
  </ul>

  <h2 id='tools'>常用工具</h2>
  <p>当前主要使用的工具和技术栈如下：</p>
  <ToolSection
    class='mb-5'
    title='开发'
    tools={[
      {
        name: 'VS Code',
        description: '主要代码编辑器',
        href: 'https://code.visualstudio.com/',
        icon: import('@/assets/tools/vscode.svg?raw')
      },
      {
        name: 'Neovim',
        description: '轻量编辑与终端工作流',
        href: 'https://neovim.io/',
        icon: import('@/assets/tools/neovim.svg?raw')
      },
      {
        name: 'ChatGPT',
        description: '研究、原型和编码协作',
        href: 'https://chatgpt.com/',
        icon: import('@/assets/tools/chatgpt.svg?raw')
      },
      {
        name: 'Codex',
        description: '代码协作与项目改造',
        href: 'https://openai.com/codex/',
        icon: import('@/assets/tools/codex.svg?raw')
      },
      {
        name: 'Typora',
        description: 'Markdown 写作',
        href: 'https://typora.io/',
        icon: import('@/assets/tools/typora.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='系统'
    tools={[
      {
        name: 'macOS',
        description: '日常开发环境',
        href: 'https://www.apple.com/macos/',
        icon: import('@/assets/tools/apple.svg?raw')
      },
      {
        name: 'Windows 11',
        description: '桌面应用测试',
        href: 'https://www.microsoft.com/windows',
        icon: import('@/assets/tools/windows11.svg?raw')
      },
      {
        name: 'Ubuntu',
        description: '服务端与 Linux 环境',
        href: 'https://ubuntu.com/',
        icon: import('@/assets/tools/ubuntu.svg?raw')
      },
      {
        name: 'Chrome',
        description: 'Web 调试',
        href: 'https://www.google.com/chrome/',
        icon: import('@/assets/tools/chrome.svg?raw')
      }
    ]}
  />

  <h2 id='social-networks'>社交网络</h2>
  <p>欢迎从 GitHub 了解我的项目，也欢迎围绕工具、产品和 AI 工作流交流。</p>
  <Substats
    stats={[
      {
        platform: 'GitHub',
        icon: 'github',
        link: 'https://github.com/seasonHL',
        text: '关注者',
        api: 'github/seasonHL'
      }
    ]}
  />

  <h2 id='about-site'>关于这个网站</h2>
  <p>这个站点从 Astro Theme Pure 改造而来，现在的方向是“作品集优先，博客次之”。</p>
  <Timeline
    events={[
      {
        date: '2025-08',
        content: '基于 Astro 和 Astro Theme Pure 搭建个人站点。'
      },
      {
        date: '2026-06',
        content: '重新整理定位，把首页改造成个人品牌与精选项目入口。'
      }
    ]}
  />
  <ul>
    <li>框架：<a href='https://astro.build/' target='_blank'>Astro</a></li>
    <li>
      基础主题：<a href='https://github.com/cworld1/astro-theme-pure' target='_blank'
        >Astro Theme Pure</a
      >
    </li>
    <li>评论系统：<a href='https://waline.js.org' target='_blank'>Waline</a></li>
    <li>托管：<a href='https://pages.github.com/' target='_blank'>GitHub Pages</a></li>
  </ul>
</PageLayout>
